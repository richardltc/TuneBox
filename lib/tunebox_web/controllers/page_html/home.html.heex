<Layouts.flash_group flash={@flash} />
<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold tracking-tight">TuneBox</h1>
      <p class="mt-2 text-base-content/60">Your personal music library</p>
    </div>

    <div class="card bg-base-200 shadow-sm">
      <div class="card-body gap-6">

        <%!-- Music library path --%>
        <div>
          <h2 class="card-title text-lg">Music Library</h2>
          <p class="text-sm text-base-content/60 mt-1">
            Set the folder on your computer where your music files are stored.
          </p>
          <div class="form-control mt-4">
            <label class="label" for="music-path">
              <span class="label-text font-medium">Music folder path</span>
            </label>
            <input
              id="music-path"
              type="text"
              placeholder="/home/user/Music"
              class="input input-bordered w-full"
            />
          </div>
        </div>

        <div class="divider my-0"></div>

        <%!-- Playback controls --%>
        <div>
          <h2 class="card-title text-lg">Playback</h2>
          <div class="flex items-center justify-center gap-2 mt-4">
            <%!-- Previous track --%>
            <button class="btn btn-ghost btn-circle" title="Previous track">
              <.icon name="hero-backward" class="w-5 h-5" />
            </button>

            <%!-- Rewind 10s --%>
            <button class="btn btn-ghost btn-circle" title="Rewind 10 seconds">
              <.icon name="hero-arrow-uturn-left" class="w-5 h-5" />
            </button>

            <%!-- Stop --%>
            <button class="btn btn-ghost btn-circle" title="Stop">
              <.icon name="hero-stop" class="w-5 h-5" />
            </button>

            <%!-- Play / Pause --%>
            <button class="btn btn-primary btn-circle" title="Play">
              <.icon name="hero-play" class="w-6 h-6" />
            </button>

            <button class="btn btn-primary btn-circle hidden" title="Pause">
              <.icon name="hero-pause" class="w-6 h-6" />
            </button>

            <%!-- Fast forward 10s --%>
            <button class="btn btn-ghost btn-circle" title="Fast forward 10 seconds">
              <.icon name="hero-arrow-uturn-right" class="w-5 h-5" />
            </button>

            <%!-- Next track --%>
            <button class="btn btn-ghost btn-circle" title="Next track">
              <.icon name="hero-forward" class="w-5 h-5" />
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
